local gmt = getrawmetatable(game)
local old_newindex = gmt.__newindex
setreadonly(gmt, false)

gmt.__newindex = newcclosure(function(t, k, v)
    if k == "Text" and type(v) == "string" then
        local clean_v = v:gsub("<[^>]+>", ""):gsub("^%s*(.-)%s*$", "%1")
        if translations[clean_v] then
            v = translations[clean_v]
        end
    end
    return old_newindex(t, k, v)
end)

setreadonly(gmt, true)
