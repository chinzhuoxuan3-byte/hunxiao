local ESPO = {}

local SKEL15 = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
}
local SKEL6 = {
    {"Head","Torso"},{"Torso","Right Arm"},{"Torso","Left Arm"},{"Torso","Right Leg"},{"Torso","Left Leg"},
}

local function ND(t, p)
    local d = Drawing.new(t)
    for k,v in pairs(p or {}) do pcall(function() d[k]=v end) end
    return d
end

local function MakeESP(pl)
    if ESPO[pl] then return end
    local skLines = {}
    for i = 1, #SKEL15+#SKEL6 do
        skLines[i] = ND("Line",{Color=Color3.fromRGB(255,200,0),Thickness=1,Visible=false})
    end
    ESPO[pl] = {
        HL  = nil,
        Box = {
            T = ND("Line",{Thickness=1,Visible=false}),
            B = ND("Line",{Thickness=1,Visible=false}),
            L = ND("Line",{Thickness=1,Visible=false}),
            R = ND("Line",{Thickness=1,Visible=false}),
        },
        NL  = ND("Text",{Center=true,Outline=true,Color=Color3.new(1,1,1),    Size=13,Font=2,Visible=false}),
        DL  = ND("Text",{Center=true,Outline=true,Color=Color3.new(.8,.8,.8), Size=11,Font=2,Visible=false}),
        HB  = ND("Line",{Color=Color3.fromRGB(0,255,0),  Thickness=3,Visible=false}),
        HBG = ND("Line",{Color=Color3.fromRGB(40,40,40), Thickness=3,Visible=false}),
        SK  = skLines,
    }
end

local function HideAll(o)
    for _,l in pairs(o.Box) do l.Visible=false end
    o.NL.Visible=false o.DL.Visible=false o.HB.Visible=false o.HBG.Visible=false
    for _,l in ipairs(o.SK) do l.Visible=false end
    if o.HL then pcall(function() o.HL.Enabled=false end) end
end

local function DelESP(pl)
    local o = ESPO[pl] if not o then return end
    if o.HL then pcall(function() o.HL:Destroy() end) end
    for _,l in pairs(o.Box) do pcall(function() l:Remove() end) end
    pcall(function() o.NL:Remove() end) pcall(function() o.DL:Remove() end)
    pcall(function() o.HB:Remove() end) pcall(function() o.HBG:Remove() end)
    for _,l in ipairs(o.SK) do pcall(function() l:Remove() end) end
    ESPO[pl] = nil
end

local function DrawESP(pl)
    local o = ESPO[pl] if not o then return end
    if pl == LocalPlayer then HideAll(o) return end
    if not T("ESPOn") then HideAll(o) return end
    local c = pl.Character if not c then HideAll(o) return end
    local root = c:FindFirstChild("HumanoidRootPart")
    local head = c:FindFirstChild("Head")
    local hum  = c:FindFirstChildOfClass("Humanoid")
    if not root or not head or not hum or hum.Health <= 0 then HideAll(o) return end
    local isAlly = T("ESPTeam") and pl.Team ~= nil and pl.Team == LocalPlayer.Team
    local myR = Root()
    local dist = myR and (root.Position-myR.Position).Magnitude or 0
    if T("ESPLimitDist") and dist > (O("ESPMaxD") or 500) then HideAll(o) return end
    local col = isAlly and (O("ESPTCol") or Color3.fromRGB(0,255,0)) or (O("ESPCol") or Color3.fromRGB(255,0,0))
    if T("ESPChams") and not isAlly then
        if not o.HL or not o.HL.Parent then
            local hl = Instance.new("Highlight")
            hl.Name = "XbHL"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = c
            o.HL = hl
        end
        o.HL.FillColor           = col
        o.HL.OutlineColor        = col
        o.HL.FillTransparency    = O("ESPFill") or 0.65
        o.HL.OutlineTransparency = O("ESPOut")  or 0
        o.HL.Enabled = true
    else
        if o.HL then pcall(function() o.HL.Enabled=false end) end
    end
    local hp3 = head.Position+Vector3.new(0,head.Size.Y/2,0)
    local fp3 = root.Position-Vector3.new(0,3,0)
    local hs,hv = Camera:WorldToViewportPoint(hp3)
    local fs,fv = Camera:WorldToViewportPoint(fp3)
    if hv and fv and T("ESPBox") then
        local H2 = math.abs(fs.Y-hs.Y)
        local W2 = H2*0.6
        local bc = O("ESPBCol") or Color3.new(1,1,1)
        local tk = O("ESPThick") or 1
        local tl = Vector2.new(hs.X-W2/2,hs.Y)
        local tr = Vector2.new(hs.X+W2/2,hs.Y)
        local bl = Vector2.new(fs.X-W2/2,fs.Y)
        local br = Vector2.new(fs.X+W2/2,fs.Y)
        o.Box.T.From=tl o.Box.T.To=tr
        o.Box.B.From=bl o.Box.B.To=br
        o.Box.L.From=tl o.Box.L.To=bl
        o.Box.R.From=tr o.Box.R.To=br
        for _,l in pairs(o.Box) do l.Color=bc l.Thickness=tk l.Visible=true end
        if T("ESPHP") then
            local rat = math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
            local bx = tl.X-5
            o.HBG.From=Vector2.new(bx,tl.Y) o.HBG.To=Vector2.new(bx,bl.Y)
            o.HBG.Thickness=tk+2 o.HBG.Visible=true
            o.HB.From=Vector2.new(bx,tl.Y+(1-rat)*H2) o.HB.To=Vector2.new(bx,bl.Y)
            o.HB.Color=Color3.fromRGB(math.floor((1-rat)*255),math.floor(rat*255),0)
            o.HB.Thickness=tk+2 o.HB.Visible=true
        else
            o.HB.Visible=false o.HBG.Visible=false
        end
        local ns = O("ESPNSize") or 13
        if T("ESPName") then
            o.NL.Text=pl.Name
            o.NL.Position=Vector2.new(hs.X,hs.Y-ns-2)
            o.NL.Color=col o.NL.Size=ns o.NL.Visible=true
        else o.NL.Visible=false end
        if T("ESPDist") then
            o.DL.Text=("[%dm]"):format(math.floor(dist))
            o.DL.Position=Vector2.new(fs.X,fs.Y+2)
            o.DL.Size=math.max(ns-2,8) o.DL.Visible=true
        else o.DL.Visible=false end
    else
        for _,l in pairs(o.Box) do l.Visible=false end
        o.NL.Visible=false o.DL.Visible=false o.HB.Visible=false o.HBG.Visible=false
    end
    for _,l in ipairs(o.SK) do l.Visible=false end
    if T("ESPSkel") then
        local isR6 = c:FindFirstChild("Torso") ~= nil
        local sk = isR6 and SKEL6 or SKEL15
        local off = isR6 and #SKEL15 or 0
        local sc = O("ESPSCol") or Color3.fromRGB(255,200,0)
        for i,pair in ipairs(sk) do
            local p1 = c:FindFirstChild(pair[1])
            local p2 = c:FindFirstChild(pair[2])
            if p1 and p2 then
                local s1,v1 = Camera:WorldToViewportPoint(p1.Position)
                local s2,v2 = Camera:WorldToViewportPoint(p2.Position)
                local ln = o.SK[off+i]
                if ln and v1 and v2 then
                    ln.From=Vector2.new(s1.X,s1.Y) ln.To=Vector2.new(s2.X,s2.Y)
                    ln.Color=sc ln.Visible=true
                end
            end
        end
    end
end

