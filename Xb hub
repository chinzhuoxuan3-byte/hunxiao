local function Notify(t, d, n) pcall(function() Library:Notify({Title=t,Description=d,Duration=n or 3}) end) end

local function SendChat(msg)
    local ok = false
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local DefaultChat = rs:FindFirstChild("DefaultChatSystemChatEvents")
        if DefaultChat then
            local SayMsg = DefaultChat:FindFirstChild("SayMessageRequest")
            if SayMsg then
                SayMsg:FireServer(msg, "All")
                ok = true
            end
        end
    end)
    if not ok then
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("DefaultChatSystemChatEvents",1)
                :WaitForChild("SayMessageRequest",1):FireServer(msg,"All")
            ok = true
        end)
    end
    if not ok then
        pcall(function()
            local ChatService = game:GetService("Chat")
            ChatService:Chat(LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head"), msg)
            ok = true
        end)
    end
    if not ok then
        pcall(function() LocalPlayer:Chat(msg) end)
    end
    return ok
end

