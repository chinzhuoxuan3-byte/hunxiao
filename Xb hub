local function GetLocalTeam()
    if LocalPlayer.Team then return LocalPlayer.Team end
    return nil
end

local function CheckVisibility(targetPart)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local ignoreList = {LocalPlayer.Character, Camera}
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            table.insert(ignoreList, player.Character)
        end
    end
    local hitPart = Workspace:FindPartOnRayWithIgnoreList(Ray.new(origin, direction), ignoreList)
    if hitPart and not hitPart:IsDescendantOf(targetPart.Parent) then
        return false
    end
    return true
end

local function IsRagdoll(character)
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum.PlatformStand or hum:GetState() == Enum.HumanoidStateType.Physics then
            return true
        end
    end
    return false
end

local function HasForceField(character)
    if character:FindFirstChildOfClass("ForceField") then
        return true
    end
    return false
end

local function GetTargetPart(character)
    if targetPartNameST == "RandomTorso/Head" then
        if math.random() > 0.5 then
            return character:FindFirstChild("Head")
        else
            return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
        end
    elseif targetPartNameST == "Torso" then
        return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
    else
        return character:FindFirstChild(targetPartNameST)
    end
end

RunService.Heartbeat:Connect(function()
    local viewportSize = Camera.ViewportSize
    local centerPos = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    if fovEnabledST then
        FovCircleST.Position = centerPos
        FovCircleST.Radius = fovRadiusST
        FovCircleST.Visible = true
    else
        FovCircleST.Visible = false
    end

    if not aimbotEnabledST then 
        currentTargetInstanceST = nil
        if TargetHighlightST.Enabled then TargetHighlightST.Enabled = false end
        if TargetHighlightST.Adornee then TargetHighlightST.Adornee = nil end
        return 
    end

    local closestDistance = math.huge
    local tempTarget = nil
    local localTeam = GetLocalTeam()

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            
            if useBlacklistST and blacklistDataST[player.Name] then continue end
            if useWhitelistST and not whitelistDataST[player.Name] then continue end

            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end
            
            if ragdollCheckEnabledST and IsRagdoll(player.Character) then continue end
            if forceFieldCheckEnabledST and HasForceField(player.Character) then continue end
            
            if teamCheckEnabledST and localTeam then
                 if player.Team == localTeam then continue end
            end

            if friendCheckEnabledST and player:IsFriendsWith(LocalPlayer.UserId) then continue end

            local targetPart = GetTargetPart(player.Character)
            
            if targetPart then
                if wallCheckEnabledST and not CheckVisibility(targetPart) then continue end
                
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                
                if onScreen or (screenPos.Z > 0) then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                    
                    if fovEnabledST and dist > fovRadiusST then
                        continue
                    end
                    
                    if dist < closestDistance then
                        closestDistance = dist
                        tempTarget = targetPart
                    end
                end
            end
        end
    end
    
    currentTargetInstanceST = tempTarget

    if showTargetEnabledST then
        if currentTargetInstanceST then
            local targetCharacter = currentTargetInstanceST.Parent
            
            if TargetHighlightST.Adornee ~= targetCharacter then
                TargetHighlightST.Adornee = targetCharacter
            end
            
            if not TargetHighlightST.Enabled then
                TargetHighlightST.Enabled = true
            end
        else
            if TargetHighlightST.Enabled then
                TargetHighlightST.Enabled = false
            end
            if TargetHighlightST.Adornee then
                TargetHighlightST.Adornee = nil
            end
        end
    else
        if TargetHighlightST.Enabled then
            TargetHighlightST.Enabled = false
        end
    end
end)

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if method == "Raycast" and self == Workspace and aimbotEnabledST and currentTargetInstanceST then
        if math.random(1, 100) <= hitChanceST then
            local origin = args[1]
            local targetPos = currentTargetInstanceST.Position
            
            if wallCheckEnabledST then
                if not CheckVisibility(currentTargetInstanceST) then
                     return oldNamecall(self, ...)
                end
            end
            
            local direction = (targetPos - origin)
            
            return {
                Position = targetPos,
                Distance = direction.Magnitude,
                Instance = currentTargetInstanceST,
                Normal = Vector3.new(0, 1, 0),
                Material = Enum.Material.Plastic
            }
        end
    end
    
    return oldNamecall(self, ...)
end)

setreadonly(mt, true)

