local function UpdateTargetVelocity(currentTarget)
    if not currentTarget then
        lastTargetPos = nil
        lastTargetTime = nil
        targetVelocity = Vector3.new(0,0,0)
        return
    end
    
    local now = tick()
    local currentPos = currentTarget.Position
    
    if lastTargetPos and lastTargetTime then
        local dt = now - lastTargetTime
        if dt > 0 then
            targetVelocity = (currentPos - lastTargetPos) / dt
        end
    else
        targetVelocity = Vector3.new(0,0,0)
    end
    
    lastTargetPos = currentPos
    lastTargetTime = now
end

RunService.Heartbeat:Connect(function()
    local viewportSize = Camera.ViewportSize
    local centerPos = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    if fovEnabled then
        AimFovCircle.Position = centerPos
        AimFovCircle.Radius = fovRadius
        AimFovCircle.Visible = true
    else
        AimFovCircle.Visible = false
    end

    if not aimbotEnabled then 
        aimTargetInstance = nil
        if AimTargetHighlight.Enabled then AimTargetHighlight.Enabled = false end
        if AimTargetHighlight.Adornee then AimTargetHighlight.Adornee = nil end
        return 
    end

    local closestDistance = math.huge
    local tempTarget = nil
    local localTeam = GetLocalTeam()

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            
            if useBlacklistST and blacklistDataST[player.Name] then continue end
            if useWhitelistST and not whitelistDataST[player.Name] then continue end

            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end
            
            if ragdollCheckEnabled and IsRagdoll(player.Character) then continue end
            if forceFieldCheckEnabled and HasForceField(player.Character) then continue end
            
            if teamCheckEnabled and localTeam then
                 if player.Team == localTeam then continue end
            end

            if friendCheckEnabled and player:IsFriendsWith(LocalPlayer.UserId) then continue end

            local targetPart = GetTargetPart(player.Character)
            
            if targetPart then
                if wallCheckEnabled and not CheckVisibility(targetPart) then continue end
                
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                
                if onScreen or (screenPos.Z > 0) then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPos).Magnitude
                    
                    if fovEnabled and dist > fovRadius then
                        continue
                    end
                    
                    if dist < closestDistance then
                        closestDistance = dist
                        tempTarget = targetPart
                    end
                end
            end
        end
    end
    
    aimTargetInstance = tempTarget

    if aimbotEnabled and aimTargetInstance then
        local shouldAim = aimAlwaysOn
        if not shouldAim and aimKeybind then
            shouldAim = aimKeybind:GetState()
        end
        
        if shouldAim then
            UpdateTargetVelocity(aimTargetInstance)
            
            local targetPos = aimTargetInstance.Position
            if aimPrediction > 0 then
                targetPos = targetPos + targetVelocity * aimPrediction
            end
            
            local cameraCF = Camera.CFrame
            local targetCF = CFrame.lookAt(cameraCF.Position, targetPos)
            
            if aimSmoothness < 1 then
                targetCF = cameraCF:Lerp(targetCF, aimSmoothness)
            end
            
            Camera.CFrame = targetCF
        else
            lastTargetPos = nil
            lastTargetTime = nil
        end
    else
        lastTargetPos = nil
        lastTargetTime = nil
    end

    if showTargetEnabled then
        if aimTargetInstance then
            local targetCharacter = aimTargetInstance.Parent
            
            if AimTargetHighlight.Adornee ~= targetCharacter then
                AimTargetHighlight.Adornee = targetCharacter
            end
            
            if not AimTargetHighlight.Enabled then
                AimTargetHighlight.Enabled = true
            end
        else
            if AimTargetHighlight.Enabled then
                AimTargetHighlight.Enabled = false
            end
            if AimTargetHighlight.Adornee then
                AimTargetHighlight.Adornee = nil
            end
        end
    else
        if AimTargetHighlight.Enabled then
            AimTargetHighlight.Enabled = false
        end
    end
end)

